#!/bin/sh

# Use the same verbose variable as CMake
[ "$VERBOSE" = "1" ] && set -x

# Exit on unset variables or pipe errors
set -uo pipefail

B_MACOS="Barrier.app/Contents/MacOS"
B_VERSION="@BARRIER_VERSION@"
B_BINDIR="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@"
B_BUILDTYPE="@CMAKE_BUILD_TYPE@"
B_BARRIERC="Barrier.app/Contents/MacOS/barrierc"
B_BARRIERS="Barrier.app/Contents/MacOS/barriers"

# Colorized output
info() { tput bold; echo "$@"; tput sgr0 ; }
error() { tput bold; tput setaf 1; echo "$@"; tput sgr0 ; }
success() { tput bold; tput setaf 2; echo "$@"; tput sgr0 ; }
warn() { tput bold; tput setaf 3; echo "$@"; tput sgr0 ; }

info "Checking for bundle contents"
if [ ! -d "Barrier.app/Contents" ]; then
    error "Please make sure that the build completed successfully"
    error "before trying to create the installer."
    exit 1
fi

if [ -d "$B_MACOS" ]; then
    info "Removing old binaries from bundle"
    rm -r "$B_MACOS"
fi

info "Copying binaries into bundle"
# Copy the three shipped binaries by name. This used to copy the whole output
# directory, which meant a tree that had ever been configured with tests
# enabled shipped guiunittests/integtests/unittests inside the .app.
mkdir -p "$B_MACOS" || exit 1
for b in barrier barriers barrierc; do
    if [ ! -x "$B_BINDIR/$b" ]; then
        error "Missing $B_BINDIR/$b -- did the build complete?"
        exit 1
    fi
    cp "$B_BINDIR/$b" "$B_MACOS/" || exit 1
done

# Check for macdeployqt on MacPorts
if which -s port ; then
    info "MacPorts found, searching for macdeployqt"
    DEPLOYQT="$(port contents qt5-qttools | grep --only --max-count 1 '/.*macdeployqt')"
    if [ ! -x "$DEPLOYQT" ]; then
        error "Please install package qt5-qttools"
        exit 1
    fi
fi

# Check for macdeployqt on Homebrew
if which -s brew ; then
    info "Homebrew found, searching for macdeployqt"
    DEPLOYQT="$(brew list qt@5 | grep --only '/.*macdeployqt' | head -1)"
    if [ ! -x "$DEPLOYQT" ]; then
        error "Please install package qt"
        exit 1
    fi
fi

# Seal the bundle with an ad-hoc signature.
#
# macdeployqt leaves the app "linker-signed", which reports Info.plist=not
# bound and Sealed Resources=none. Privacy & Security on recent macOS cannot
# pin an Accessibility grant to a bundle like that, so the permission either
# refuses to stick or cannot be added at all. Signing the whole bundle binds
# the Info.plist and seals resources, which gives TCC a stable identity.
#
# This is an ad-hoc signature, not a Developer ID: it is enough for the system
# to hold the permission on this machine, but the identity changes whenever the
# binaries are rebuilt, so the grant may need to be re-applied after a rebuild.
sign_bundle() {
    # Prefer a real signing identity over an ad-hoc signature.
    #
    # An ad-hoc signature has no stable identity: its hash changes on every
    # rebuild, so macOS treats each build as a different application and drops
    # the Accessibility grant. The app then exits at startup (main.cpp checks
    # AXIsProcessTrusted and returns 1), which looks like "it asks for
    # permission it already has and never opens".
    #
    # Signing with a certificate from the keychain keeps the identity stable
    # across rebuilds, so the grant sticks. Override with
    # BARRIER_CODESIGN_IDENTITY, or set it to "-" to force ad-hoc.
    if [ -z "${BARRIER_CODESIGN_IDENTITY:-}" ]; then
        BARRIER_CODESIGN_IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null \
            | awk -F'"' '/"/ {print $2; exit}')
    fi

    if [ -n "$BARRIER_CODESIGN_IDENTITY" ] && [ "$BARRIER_CODESIGN_IDENTITY" != "-" ]; then
        info "Signing bundle as: $BARRIER_CODESIGN_IDENTITY"
    else
        BARRIER_CODESIGN_IDENTITY="-"
        warn "No signing identity found; using an ad-hoc signature."
        warn "The Accessibility grant will be dropped on every rebuild."
    fi

    codesign --force --deep --sign "$BARRIER_CODESIGN_IDENTITY" \
             --identifier "org.barrier-foss.barrier" \
             --timestamp=none \
             Barrier.app || { error "codesign failed"; exit 1; }

    codesign --verify --deep --strict Barrier.app \
        || { error "bundle failed signature verification"; exit 1; }
    success "Bundle signed and verified"
}

# Use macdeployqt to include libraries and create dmg
if [ "$B_BUILDTYPE" = "Release" ]; then
    info "Deploying Qt libraries"
    "$DEPLOYQT" Barrier.app \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1

    sign_bundle

    info "Building Release disk image (dmg)"
    "$DEPLOYQT" Barrier.app -dmg || exit 1
    mv "Barrier.dmg" "Barrier-$B_VERSION.dmg" || exit 1
    success "Created Barrier-$B_VERSION.dmg"
else
    warn "Disk image (dmg) only created for Release builds"
    info "Building debug bundle"
    "$DEPLOYQT" Barrier.app -no-strip \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1

    sign_bundle
    success "Bundle created successfully"
fi
